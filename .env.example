# Environment variables read by the CI helper scripts in ci/ and by the
# commands in docs/source/contributing/AGENTS.md. Nothing loads this file:
# export the values you need in your shell, for example with
#   set -a; . ./.env; set +a
# after copying it to .env. Every setting is optional; the values below are
# safe examples.

# kas-container launcher. Unset: the kas-container found on PATH.
KAS_CONTAINER=/usr/local/bin/kas-container
# Container engine kas-container uses (docker or podman). Unset: Docker when
# installed, otherwise Podman.
KAS_CONTAINER_ENGINE=docker
# kas work folder, outside the checkout. Unset: kas-shell-helper.sh creates a
# temporary folder; kas-container uses the current folder.
KAS_WORK_DIR=/srv/kas-work
# Shared download and shared state caches, outside the checkout. Unset:
# folders inside the build folder.
DL_DIR=/srv/yocto-cache/downloads
SSTATE_DIR=/srv/yocto-cache/sstate-cache
# kas files for kas-container-shell-helper.sh, joined with ':'. Unset:
# ci/base.yml.
KAS_YAMLS=ci/rb3gen2-core-kit.yml:ci/qcom-distro.yml
# Extra kas-container options for kas-container-shell-helper.sh. Unset: none.
KAS_OPTS="--runtime-args --env=MACHINE=rb3gen2-core-kit"
# Machine for ci/oe-selftest.sh. Unset: rb3gen2-core-kit.
MACHINE=rb3gen2-core-kit
# Any non-empty value makes ci/oe-selftest.sh keep Git clones job-local and
# fetch the linux-qcom kernels shallow, as CI does. Unset: DL_DIR/git2 is the
# clone cache.
GIT_CLONEDIR_JOB_LOCAL=1
