# Environment settings read by kas and the ci/ helper scripts. Nothing loads
# this file: copy it to .env, then run `set -a; . ./.env; set +a` or export the
# values you need. Every setting is optional.

# kas-container script to run; default: the kas-container on PATH.
#KAS_CONTAINER=/opt/kas/kas-container
# Container engine for kas-container, docker or podman; default: docker when
# installed, otherwise podman.
#KAS_CONTAINER_ENGINE=podman
# Extra kas-container options for ci/kas-container-shell-helper.sh; default: none.
#KAS_OPTS="--runtime-args --env=GIT_CLONEDIR_JOB_LOCAL=1"
# kas fragments for the helper's shell; default: ci/base.yml.
#KAS_YAMLS=ci/rb3gen2-core-kit.yml:ci/qcom-distro.yml
# kas work directory, outside the checkout; default: the current directory
# (kas-container) or a new temporary directory (ci/kas-shell-helper.sh).
#KAS_WORK_DIR=/srv/kas-work
# Shared download and shared-state caches; default: folders in the build directory.
#DL_DIR=/srv/yocto-cache/downloads
#SSTATE_DIR=/srv/yocto-cache/sstate-cache
# The two settings below are read inside the container; kas-container passes
# them only through KAS_OPTS, for example --runtime-args --env=MACHINE=qcm6490-idp.
# Machine for ci/oe-selftest.sh; default: rb3gen2-core-kit.
#MACHINE=rb3gen2-core-kit
# Set to any value to keep oe-selftest git clones job-local, as CI does; default: unset.
#GIT_CLONEDIR_JOB_LOCAL=1
